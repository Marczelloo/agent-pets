<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "binaries": the app and hook.exe, signed before they go into the installer
     (.github/workflows/release.yml, step "Sign the binaries"). -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="agent-pets.exe">
      <authenticode-sign />
    </pe-file>
    <pe-file path="hook.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
