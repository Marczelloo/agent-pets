{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Pets",
  "version": "0.7.0",
  "identifier": "dev.agentpets.app",
  "build": {
    "beforeDevCommand": "pnpm build:hook && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && pnpm build:hook",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/hook.exe": "resources/hook.exe",
      "icons/128x128.png": "icons/128x128.png"
    },
    "publisher": "Marczelloo",
    "shortDescription": "Animated pets in the Windows taskbar for your coding agents",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Polish"
        ],
        "displayLanguageSelector": false,
        "customLanguageFiles": {
          "Polish": "nsis/Polish.nsh"
        },
        "installerHooks": "nsis/hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  },
  "mainBinaryName": "agent-pets",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5N0U0MDg2NEYzMTM2NTIKUldSU05qRlBoa0IrR2YweC8xZWZXa3lFc3o5YURReXN2RE4zbkl4M2hyTjFaRFRxUStzTkNmRWMK",
      "endpoints": [
        "https://github.com/Marczelloo/agent-pets/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
